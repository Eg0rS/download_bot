# Telegram Bot Token (обязательно)
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Режим работы
APP_ENV=production
LOG_LEVEL=info

# Redis (для очереди и кэша)
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# База данных (SQLite по умолчанию)
DB_DRIVER=sqlite
DB_DSN=file:/data/bot.db?cache=shared&mode=rwc

# Временная директория для скачивания
TEMP_DIR=/tmp/media-downloader

# Максимальный размер файла (МБ) — 2048 для Telegram Premium
MAX_FILE_SIZE_MB=2048

# Webhook (опционально)
WEBHOOK_ENABLED=false
WEBHOOK_HOST=
WEBHOOK_PORT=8080
WEBHOOK_PATH=/webhook

# Админы (через запятую)
ADMIN_IDS=123456789,987654321