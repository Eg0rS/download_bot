# Copy to .env; never commit real tokens.
BOT_TOKEN=
ADMIN_IDS=
APP_ENV=production
LOG_LEVEL=info
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
DB_DRIVER=sqlite
DB_DSN=file:bot.db?_busy_timeout=5000
TEMP_DIR=/tmp/media-downloader
# Public Telegram Bot API upload limit.
MAX_FILE_SIZE_MB=50
DOWNLOADER_MAX_CONCURRENT=2
DOWNLOADER_TIMEOUT_MINUTES=10
WEBHOOK_ENABLED=false
